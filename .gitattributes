# Text files are stored with LF in the repository; Windows tools get CRLF on checkout where they want it.
* text=auto
*.iss text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.reg text eol=crlf

# Binary files: leave them alone.
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.webp binary
*.zip binary
*.exe binary
*.dll binary
